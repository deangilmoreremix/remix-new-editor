{
  "name": "open-higgsfield-ai",
  "description": "Open-source alternative to Higgsfield AI — AI image generation and cinema studio with 20+ models",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "clean": "rm -rf dist",
    "build:packages": "npm run build --workspaces --if-present",
    "dev:packages": "npm run dev --workspaces --if-present",
    "dev:backend": "cd backend && npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/ui": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.24",
    "canvas": "^3.2.3",
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "puppeteer": "^24.37.2",
    "tailwindcss": "^4.1.18",
    "terser": "^5.27.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.10",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@higgsfield/layout": "file:packages/layout",
    "@higgsfield/navigation": "file:packages/navigation",
    "@higgsfield/tokens": "file:packages/tokens",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "exifr": "^7.1.3",
    "file-type": "^22.0.1",
    "framer-motion": "^11.18.2",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^2.0.10",
    "idb-keyval": "^6.2.6",
    "lucide-react": "^1.8.0",
    "mediainfo.js": "^0.3.7",
    "mime-types": "^3.0.2",
    "mobx": "^6.12.0",
    "mobx-react": "^9.2.2",
    "moment": "^2.30.1",
    "mp4box": "^2.4.1",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
