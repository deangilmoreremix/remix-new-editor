{
  "name": "bloom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-blog.mjs && node scripts/generate-changelog.mjs && tsc -b && vite build && vite build --ssr src/entry-ssr.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/indexnow.mjs",
    "lint": "eslint .",
    "indexnow": "node scripts/indexnow.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/test src/lib/__tests__ src/lib/editor/__tests__",
    "test:integration": "vitest run src/test/api-integration.test.js src/test/render-actions.test.js",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:all": "node scripts/run-tests.js --all",
    "test:security": "npm audit --audit-level=high",
    "test:ci": "npm run lint && npm run test:unit && npm run test:security",
    "dev:control-center": "cd apps/control-center && PORT=3101 npm run dev"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/roboto": "^5.2.10",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "driver.js": "^1.4.0",
    "esbuild-wasm": "^0.28.0",
    "framer-motion": "^12.12.1",
    "hash-wasm": "^4.12.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/fraunces": "^5.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "satori": "^0.26.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.8"
  }
}
