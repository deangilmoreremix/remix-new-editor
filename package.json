{
  "name": "smartvideo",
  "description": "SmartVideo — AI video generation studio with 20+ models",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n root,aivfx -c magenta,green \"npm run dev\" \"npm run dev --workspace apps/ai-vfx\"",
    "build": "rm -rf dist && npm run build --workspace apps/ai-vfx && vite build && cp -R apps/ai-vfx/dist dist/ai-vfx",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "lint:cinema-hex": "node scripts/check-cinema-hex.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "clean": "rm -rf dist",
    "build:packages": "npm run build --workspaces --if-present",
    "dev:packages": "npm run dev --workspaces --if-present",
    "dev:backend": "cd backend && npm run dev"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.2",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "canvas": "^3.2.3",
    "concurrently": "^9.0.0",
    "eslint": "^10.6.0",
    "jsdom": "^27.4.0",
    "popcorn-js": "https://github.com/strategic-limited/popcorn-js.git#060d40cb3b1a9aff4f67f9c479071b49aa27959a",
    "postcss": "^8.5.6",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.2",
    "terser": "^5.48.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.10",
    "@clerk/clerk-js": "^6.20.0",
    "@clerk/react": "^6.12.4",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@higgsfield/ai-chat": "file:packages/ai-chat",
    "@higgsfield/audio-mixer": "file:packages/audio-mixer",
    "@higgsfield/color-grading": "file:packages/color-grading",
    "@higgsfield/layout": "file:packages/layout",
    "@higgsfield/navigation": "file:packages/navigation",
    "@higgsfield/style-templates": "file:packages/style-templates",
    "@higgsfield/subtitles": "file:packages/subtitles",
    "@higgsfield/timeline-editor": "file:packages/timeline-editor",
    "@higgsfield/tokens": "file:packages/tokens",
    "@higgsfield/transitions": "file:packages/transitions",
    "@higgsfield/video-compiler": "file:packages/video-compiler",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "file-type": "^22.0.1",
    "framer-motion": "^11.18.2",
    "gl-transitions": "^1.43.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^2.0.10",
    "idb-keyval": "^6.2.6",
    "interactjs": "^1.10.2",
    "jquery": "^3.7.1",
    "jquery-textfill": "^0.6.0",
    "lodash": "^4.18.1",
    "lottie-web": "^5.6.6",
    "lucide": "^1.24.0",
    "lucide-react": "^1.8.0",
    "mediainfo.js": "^0.3.7",
    "mime-types": "^3.0.2",
    "mobx": "^6.12.0",
    "mobx-react": "^9.2.2",
    "moment": "^2.30.1",
    "mp4box": "^2.4.1",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hotkeys-hook": "^5.3.2",
    "socket.io-client": "^4.8.3",
    "react-resizable-panels": "^4.11.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "timeline": "^3.4.1",
    "validator": "^13.15.35",
    "wavesurfer.js": "^7.12.7",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
