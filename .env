# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk Configuration (Required)
# Vite only exposes VITE_-prefixed vars to the client, so use VITE_CLERK_PUBLISHABLE_KEY here.
# LOCAL DEV uses the Clerk *development* instance (pk_test_/sk_test_), which is
# allowed to run on localhost. The *production* keys (pk_live_/sk_live_) only
# work on the smartvid.app domain, so set those in the Netlify env, NOT here.
# SECURITY: Never commit production keys. Set via deployment environment only.
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here

# MuAPI Configuration
# MUAPI_API_KEY is set in Supabase Edge Function secrets (supabase secrets set MUAPI_API_KEY=your-key)
# Users provide their own key via the app Settings UI; it is stored in browser localStorage.

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false
# VITE_SENTRY_DSN=

# Dev-only auth bypass — skips the API key prompt in local dev.
# Enabled locally via a local-only .env.local file (gitignored) or by appending
# ?dev to the URL (e.g. http://localhost:3000/?dev). Intentionally NOT set here
# so the committed .env never enables the bypass in production builds.
# VITE_DEV_BYPASS_AUTH=true

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_BUILD_HASH=devel
