# Required: clients must send this in X-API-Key to call /scan
MAIGRET_API_KEY=replace-me-with-a-long-random-string

# Optional but recommended: separate key for /cache DELETE and /stats
# Falls back to MAIGRET_API_KEY if not set
MAIGRET_ADMIN_KEY=replace-me-with-another-long-random-string

# Cache: "memory" (default, in-process) or "redis" (multi-instance safe)
MAIGRET_CACHE_BACKEND=memory

# When MAIGRET_CACHE_BACKEND=redis, point at your Redis instance
# REDIS_URL=redis://localhost:6379/0

# How long to keep a scan result cached (default 24h)
MAIGRET_CACHE_TTL_SECONDS=86400

# Max concurrent scans (semaphore). Tune for the plan's CPU/RAM.
MAIGRET_MAX_CONCURRENT=4

# Per-API-key rate limit (scans per hour)
MAIGRET_PER_KEY_LIMIT=100

# Hard timeout for a single scan (seconds)
MAIGRET_SCAN_TIMEOUT=90

# CORS — comma-separated origins or * for any
ALLOWED_ORIGINS=*

# Port to bind (Render sets PORT automatically; default 8000)
PORT=8000
