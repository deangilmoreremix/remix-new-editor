# opengrab-worker as ONE container for Beam: gateway (public, $PORT) + vendored OpenGrab (127.0.0.1 only).
# Build context: this folder.   beam deploy --dockerfile Dockerfile.beam --name opengrab-worker --port 8000 ...
FROM python:3.13-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --no-log-init worker \
 && mkdir -p /data/downloads && chown -R worker:worker /data

WORKDIR /app
COPY requirements.txt ./
# upstream's own dependencies (fastapi, uvicorn, yt-dlp, slowapi, prometheus_client) plus httpx for the gateway
RUN pip install --no-cache-dir -r requirements.txt slowapi prometheus_client

COPY upstream/ /app/upstream/
COPY gateway/ /app/gateway/
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

ENV HOME=/tmp PORT=8000 OPENGRAB_DIR=/data/downloads OPENGRAB_CONFIG=/data/downloads/config.ini \
    OPENGRAB_AUTOUPDATE=0 OPENGRAB_HOST=127.0.0.1 OPENGRAB_PORT=8800 PYTHONUNBUFFERED=1
EXPOSE 8000
# start.sh prepares the (possibly root-owned) /data mount, then drops to the unprivileged "worker" user.
CMD ["/app/start.sh"]
