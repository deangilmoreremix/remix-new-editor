  "results-grid": {
    "setup": "new Promise((done) => { let n = 0; const t = setInterval(() => { const el = document.querySelector('[data-vfx-results]'); if (!el && ++n < 80) return; clearInterval(t); if (el) { el.classList.remove('hidden'); el.innerHTML = '<div class=\"rounded-2xl border border-white/10 bg-card-bg aspect-video flex items-center justify-center text-xs text-white/60\"><span class=\"animate-pulse\">Rendering Cakeify\u2026</span></div><div class=\"rounded-2xl overflow-hidden border border-white/10 bg-card-bg\"><video src=\"/media/awesome-seedance/videos/john1.mp4#t=1\" preload=\"auto\" muted class=\"w-full aspect-video bg-black object-contain\" controls playsinline loop></video><div class=\"p-3 flex items-center justify-between gap-2\"><span class=\"text-xs font-bold text-white truncate\">360 Rotation</span><a href=\"#\" class=\"text-xs font-bold text-primary hover:underline\">Download</a></div></div><div class=\"rounded-2xl overflow-hidden border border-white/10 bg-card-bg\"><video src=\"/media/awesome-seedance/videos/vicky.mp4#t=1\" preload=\"auto\" muted class=\"w-full aspect-video bg-black object-contain\" controls playsinline loop></video><div class=\"p-3 flex items-center justify-between gap-2\"><span class=\"text-xs font-bold text-white truncate\">Boxing</span><a href=\"#\" class=\"text-xs font-bold text-primary hover:underline\">Download</a></div></div>'; const vs = [...el.querySelectorAll('video')]; let left = vs.length; vs.forEach((v) => v.addEventListener('loadeddata', () => { if (--left === 0) setTimeout(done, 300); })); setTimeout(done, 10000); return; } done(); }, 250); })",
    "reload": false,
    "selector": "[data-vfx-results]"
  }
}
