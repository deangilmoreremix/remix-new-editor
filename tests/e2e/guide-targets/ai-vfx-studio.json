{
  "prompt-box": {
    "selector": "textarea"
  },
  "image-input-upload-or-url": {
    "selector": "[data-vfx-image]",
    "click": false
  },
  "aspect-duration-size-quality-dropdowns": {
    "selector": "xpath=//select[@data-vfx-control=\"aspect_ratio\"]/../..",
