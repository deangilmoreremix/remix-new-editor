{
  "scale-factor": {
    "steps": [
      {
        "selector": "#upscale-advanced-btn"
      }
    ],
    "selector": "[data-studio-advanced-panel]"
  },
  "upscale-image": {
    "selector": "xpath=//button[normalize-space(.)=\"Upscale Image\"]",
    "click": false
