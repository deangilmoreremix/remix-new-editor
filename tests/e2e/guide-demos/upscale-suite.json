{
  "upload-and-pexels": {
    "selector": "button[aria-label=\"Reference media\"], button[title=\"Reference media\"]",
    "then": [
      {
        "text": "Upload",
        "exact": true,
        "upload": true,
        "file": "image",
        "hold": 2200
      }
    ]
  },
  "method-picker": {
    "selector": "xpath=//button[normalize-space(.)=\"AI Upscaler\"]",
    "click": true,
    "then": [
      {
        "text": "Topaz Upscale",
        "hold": 1800
      }
    ]
  }
}
