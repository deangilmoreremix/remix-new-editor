{
  "gtm-boost": {
    "selector": "#gtm-base-prompt",
    "click": true,
    "type": "Hero image for a premium cold-brew coffee brand",
    "then": [
      {
        "selector": "xpath=//button[contains(@class,'gtm-chip') and normalize-space(.)='Social ad']"
      },
      {
        "selector": "#gtm-industry-select",
        "hold": 1000
      },
      {
        "selector": "xpath=//button[contains(@class,'gtm-chip') and normalize-space(.)='Awareness']"
      }
    ]
  },
  "example-prompts": {
    "selector": "xpath=(//button[contains(@class,'try-btn')])[1]",
    "click": true,
    "hold": 3000
  },
  "available-models": {
    "selector": ".model-card",
    "click": true,
    "hold": 3000
  }
}