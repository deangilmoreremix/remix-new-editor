{
  "hub-all-tracks": {
    "selector": "button:has-text(\"Track 1\")",
    "click": true
  },
  "lesson-page-learn-tab": {
    "then": [
      {
        "text": "Read full lesson",
        "hold": 2500
      }
    ]
  },
  "lesson-page-see-tab": {
    "then": [
      {
        "wait": 2500
      }
    ]
  },
  "lesson-page-create-tab": {
    "then": [
      {
        "text": "Open template",
        "hold": 2500
      },
      {
        "selector": "input >> nth=0",
        "type": "GripMount magnetic phone mount",
        "hold": 1500
      }
    ]
  },
  "progress-tracking": {
    "route": "academy/track/01-ai-video-ads-ugc/lesson/how-ugc-works",
    "selector": "button[title=\"Mark as completed\"]",
    "click": true
  },
  "bookmarks": {
    "route": "academy/track/01-ai-video-ads-ugc/lesson/how-ugc-works",
    "selector": "button[title=\"Bookmark for later\"]",
    "click": true
  },
  "template-editor": {
    "then": [
      {
        "text": "Use Template",
        "hold": 1500
      }
    ]
  }
}