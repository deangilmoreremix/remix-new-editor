{
  "video-image-switch": {
    "selector": "xpath=//button[normalize-space(.)='Image']",
    "click": true,
    "hold": 1500,
    "then": [
      {
        "selector": "xpath=//button[normalize-space(.)='Video']",
        "hold": 1500
      }
    ]
  },
  "camera-and-lens-controls": {
    "selector": "#builder-camera",
    "click": true,
    "hold": 1200,
    "then": [
      {
        "selector": "#builder-lens",
        "hold": 1500
      }
    ]
  },
  "camera-movement": {
    "selector": "#builder-movement",
    "click": true,
    "hold": 2000
  },
  "film-look": {
    "selector": "#builder-look",
    "click": true,
    "hold": 2000
  },
  "cinema-prompt-builder": {
    "selector": "xpath=//button[.//div[normalize-space(.)='Cinema Prompt Builder']]",
    "click": true,
    "then": [
      {
        "selector": "xpath=//input[@placeholder='Base scene description...']",
        "type": "A lone rider on a neon-lit desert highway at dusk",
        "hold": 2500
      }
    ]
  },
  "start-frame-and-end-frame": {
    "selector": "xpath=//button[starts-with(@aria-label,'Starting image for the video') or starts-with(@title,'Starting image for the video')]",
    "click": true,
    "then": [
      {
        "upload": true,
        "file": "image",
        "hold": 3000,
        "selector": "xpath=(//*[normalize-space(text())='Pick a file'] | //button[contains(.,'Upload new') or contains(.,'Upload files')])[1]"
      }
    ]
  },
  "character-lock": {
    "selector": "#cs-character-lock-btn",
    "click": true,
    "hold": 2500
  }
}