{
  "find-my-brand-button": {
    "steps": [
      {
        "selector": "button[aria-label='Close personalization modal']",
        "wait": 1500
      }
    ],
    "selector": "button:has-text('FIND MY BRAND')",
    "click": true,
    "hold": 2500
  },
  "website-url-discovery": {
    "selector": "#find-my-brand-url",
    "click": true,
    "type": "https://www.bluebottlecoffee.com",
    "steps": [
      {
        "selector": "button:has-text('Find My Brand')",
        "wait": 9000
      }
    ]
  },
  "search-for-a-business-instead": {
    "then": [
      {
        "selector": "select#business-niche",
        "hold": 1000
      },
      {
        "selector": "input#business-location",
        "type": " Austin, Texas",
        "hold": 800
      }
    ],
    "steps": [
      {
        "selector": "button:has-text('Find My Brand')",
        "wait": 9000
      }
    ],
    "selector": "button:has-text('find a local business by niche')",
    "click": true
  }
}