{
  "remove-object": {
    "steps": [{ "selector": "button[aria-label=\"Open Remove Object\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 3000
  },
  "remove-background": {
    "steps": [{ "selector": "button[aria-label=\"Open Remove Background\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 3000
  },
  "extend-image": {
    "steps": [{ "selector": "button[aria-label=\"Open Extend Image\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 3000
  },
  "ai-edit": {
    "steps": [{ "selector": "button[aria-label=\"Open AI Edit\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 2000,
    "then": [
      { "selector": "textarea[aria-label=\"Edit prompt\"]", "type": "Make it night time with city lights glowing", "hold": 800 },
      { "selector": "select[aria-label=\"Aspect Ratio\"]", "hold": 1000 }
    ]
  },
  "reframe": {
    "steps": [{ "selector": "button[aria-label=\"Open Reframe\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 2000,
    "then": [{ "selector": "select", "hold": 1200 }]
  },
  "change-dress": {
    "steps": [{ "selector": "button[aria-label=\"Open Change Dress\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 2000
  },
  "add-watermark": {
    "steps": [{ "selector": "button[aria-label=\"Open Add Watermark\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 2000
  },
  "photo-effects": {
    "steps": [{ "selector": "button[aria-label=\"Open Photo Effects\"]", "wait": 1800 }],
    "selector": "button[aria-label=\"Reference media\"]",
    "upload": true, "file": "image", "hold": 2000
  }
}
