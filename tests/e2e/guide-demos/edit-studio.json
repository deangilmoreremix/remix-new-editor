{
  "remove-object": {
    "steps": [
      {
        "selector": "button[aria-label=\"Open Remove Object\"]",
        "wait": 1800
      }
    ],
    "selector": "button[aria-label=\"Reference media\"], button[title=\"Reference media\"]",
    "then": [
      {
        "text": "Upload",
        "exact": true,
        "upload": true,
        "file": "image",
        "hold": 2200
      }
    ]
  },
