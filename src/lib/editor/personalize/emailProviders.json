[
  {
    "key": "mailchimp",
    "label": "Mailchimp",
    "open": "*|",
    "close": "|*",
    "fields": {
      "firstName": "FNAME",
      "lastName": "LNAME",
      "email": "EMAIL",
      "phone": "PHONE",
      "businessPhone": "PHONE"
    },
    "custom": {
      "case": "upper",
      "prefix": ""
    },
    "recipientId": "UNIQID",
    "recipientUnverified": true
  },
  {
    "key": "activecampaign",
    "label": "ActiveCampaign",
    "open": "%",
    "close": "%",
    "fields": {
      "firstName": "FIRSTNAME",
      "lastName": "LASTNAME",
      "email": "EMAIL",
      "fullName": "FULLNAME",
      "company": "ORGNAME"
    },
    "custom": {
      "case": "upper",
      "prefix": ""
    }
  },
  {
    "key": "klaviyo",
    "label": "Klaviyo",
    "open": "{{ ",
    "close": " }}",
    "fields": {
      "firstName": "first_name",
      "lastName": "last_name",
      "email": "email",
      "company": "person.organization",
      "title": "person.title",
      "phone": "person.phone_number",
      "businessPhone": "person.phone_number"
    },
    "custom": {
      "case": "as-is",
      "prefix": "person."
    }
  },
  {
    "key": "hubspot",
