{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ],
    "paths": {
      "@ohb/*": [
        "./src/features/personalization/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ES2022",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/features/personalization/shared/personalization/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
