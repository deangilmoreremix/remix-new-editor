# Intelligence & Personalization API rewrites
# In dev, Vite proxies /api/intelligence/* and /api/personalizer/* to the
# Netlify CLI functions server on :8888. In production, Netlify serves
# the functions at /.netlify/functions/* — these rewrites map the
# /api/* paths to the function URLs so the frontend code works in both.

/api/intelligence/*  /.netlify/functions/intelligence-api/:splat  200
/api/personalizer/*   /.netlify/functions/personalizer-api/:splat   200

# SmartWarmupAI backend (Beam): the dashboard calls /smartwarmupai-api/v1/..., Netlify forwards it. After a new `beam deploy`,
# update this host (find it with `beam deployment list --format json`: the stub_id, then https://<stub_id>-8080.app.beam.cloud).
/smartwarmupai-api/*  https://87049234-4344-4617-8c64-99e77a8cf105-8080.app.beam.cloud/:splat  200

# SmartVidDownloader (Beam): the gate (backend/beam-gate) does the sign-in check and the allowlist, then forwards to the downloader pod.
# The browser only ever talks to smartvid.app, so the session cookie stays first-party. After a new `beam deploy` of the gate
# (`beam deployment list --format json`: its stub_id, then https://<stub_id>-8080.app.beam.cloud) update both lines.
/api/vidbee/*  https://d7bedcad-9589-4d9f-8913-f81657ab5657-8080.app.beam.cloud/api/vidbee/:splat  200
/vidbee/*  https://d7bedcad-9589-4d9f-8913-f81657ab5657-8080.app.beam.cloud/vidbee/:splat  200

# SmartWarmupAI studio (embedded dashboard): client-side routes fall back to its index.html. Real files win (non-forced).
/smartwarmupai-app/*  /smartwarmupai-app/index.html  200

# The Studio guide was renamed SmartVid Studio: keep the old public address working
/studios/muapi-studio    /studios/smartvid-studio/  301
/studios/muapi-studio/   /studios/smartvid-studio/  301
