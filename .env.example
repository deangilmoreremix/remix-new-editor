# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk Authentication (Required) — instance: clerk.smartvid.app (production)
# Frontend (browser-exposed, needs the VITE_ prefix):
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
# Server-only (must also be set in Netlify deploy env + Supabase edge secrets):
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
# Webhook signing secret — used by netlify/functions/clerk-webhook.js to verify
# Clerk event signatures. Set the same value in Netlify deploy env and register
# the endpoint https://<your-site>/.netlify/functions/clerk-webhook in the
# Clerk dashboard (Webhooks → Add Endpoint) with the user.created/updated/deleted events.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# MuAPI Configuration
# MUAPI_API_KEY is set in Supabase Edge Function secrets (supabase secrets set MUAPI_API_KEY=your-key)
# Users provide their own key via the app Settings UI; it is stored in browser localStorage.

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false
# VITE_SENTRY_DSN=

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_BUILD_HASH=devel
