# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk Configuration (Required)
# Get these from https://dashboard.clerk.com → API Keys
# Vite only exposes VITE_-prefixed vars to the client. For server-side code
# (e.g. backend / edge functions) you can also keep CLERK_SECRET_KEY as-is.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# MuAPI Configuration
# MUAPI_API_KEY is set in Supabase Edge Function secrets (supabase secrets set MUAPI_API_KEY=your-key)
# Users provide their own key via the app Settings UI; it is stored in browser localStorage.

# Backend Proxy URL
# When set, VideoDB calls (index, search, stream, resolve) route through the
# Render backend proxy instead of calling api.videodb.io directly from the browser.
# This is required for the four studios (Timeline Editor, Render Studio,
# Video Agent Studio, Director) to use the server-side VideoDB key on Render.
VITE_BACKEND_URL=https://videoagent-backend.onrender.com

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false
# VITE_SENTRY_DSN=

# Dev-only auth bypass — skips the API key prompt in local dev.
# Set to true, or append ?dev to the URL (e.g. http://localhost:3000/?dev).
# Never enable this in production.
VITE_DEV_BYPASS_AUTH=false

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_BUILD_HASH=devel

# Netlify / Namecheap CLI notes
# Netlify: `netlify login` then `netlify link` to attach a site.
# Namecheap: requires `NAMECHEAP_API_USER`, `NAMECHEAP_API_KEY`, and `NAMECHEAP_USERNAME`
# env vars. Set them in your shell or via `netlify env:set` for deploy contexts.
