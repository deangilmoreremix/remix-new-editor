# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# MuAPI Configuration
# MUAPI_API_KEY is set in Supabase Edge Function secrets (supabase secrets set MUAPI_API_KEY=your-key)
# Users provide their own key via the app Settings UI; it is stored in browser localStorage.

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false
# VITE_SENTRY_DSN=

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_BUILD_HASH=devel
