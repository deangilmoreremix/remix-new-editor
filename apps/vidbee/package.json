{
  "name": "vidbee-vendored",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "install:vidbee": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile",
    "setup": "pnpm --filter ./apps/desktop run setup",
    "build": "VIDBEE_BASE_PATH=${VIDBEE_BASE_PATH:-/vidbee} pnpm --filter ./apps/desktop run build",
    "build:api": "pnpm --filter api run build",
    "build:web": "pnpm --filter web run build",
    "build:cli": "pnpm --filter ./apps/cli run build",
    "build:extension": "pnpm --filter ./apps/extension build",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "start": "cd apps/desktop && VIDBEE_STATIC_DIR=out-web/renderer VIDBEE_BASE_PATH=${VIDBEE_BASE_PATH:-/vidbee} node out-web/server.mjs"
  }
}
