# Smartvid Downloader as ONE container (for Beam or any single-container host): API + web, one public port (3000).
# Build from this folder:  docker build -f Dockerfile.beam -t smartvid .
# Mount ONE persistent disk at /data (downloads in /data/downloads, database and settings in /data/smartvid).
# Run exactly one instance: SQLite, the task queue and live AI runs are in-process.

FROM node:22-bookworm AS api-builder
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
ENV HUSKY=0
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches patches
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/downloader-core/package.json packages/downloader-core/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/subscriptions-core/package.json packages/subscriptions-core/package.json
COPY packages/task-queue/package.json packages/task-queue/package.json
COPY packages/transcription/package.json packages/transcription/package.json
RUN pnpm install --filter "{./apps/api}..." --frozen-lockfile
COPY apps/api apps/api
COPY packages/db packages/db
COPY packages/downloader-core packages/downloader-core
COPY packages/i18n packages/i18n
COPY packages/logger packages/logger
COPY packages/subscriptions-core packages/subscriptions-core
COPY packages/task-queue packages/task-queue
COPY packages/transcription packages/transcription
RUN pnpm --filter ./apps/api run build
RUN pnpm --filter ./apps/api deploy --prod --legacy --config.allowUnusedPatches=true /prod/api

FROM node:22-bookworm AS web-builder
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches patches
COPY apps/web/package.json apps/web/package.json
COPY packages/downloader-core/package.json packages/downloader-core/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/subscriptions-core/package.json packages/subscriptions-core/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --filter "{./apps/web}..." --frozen-lockfile --ignore-scripts
COPY apps/web apps/web
COPY packages/downloader-core packages/downloader-core
COPY packages/i18n packages/i18n
COPY packages/logger packages/logger
COPY packages/subscriptions-core packages/subscriptions-core
COPY packages/ui packages/ui
# Built for the sub-path the host apps proxy it under (/smartvid); the page and its API calls use that prefix.
RUN SMARTVID_BASE_PATH=/smartvid pnpm --filter ./apps/web run build
RUN mkdir -p /prod/web/node_modules/@smartvid && cp -RL packages/logger /prod/web/node_modules/@smartvid/logger

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV SMARTVID_API_HOST=127.0.0.1
ENV SMARTVID_API_PORT=3100
ENV SMARTVID_DOWNLOAD_DIR=/data/downloads
ENV SMARTVID_DATA_DIR=/data/smartvid
ENV SMARTVID_MIGRATIONS_DIR=/app/api/resources/drizzle
ENV SMARTVID_PERSIST_QUEUE=1
ENV SMARTVID_SKILLS_DIR=/app/api/skills
# Bring your own key: every visitor uses their own OpenAI key (kept in their browser, sent per request, never stored here).
ENV SMARTVID_AI_MODE=byok
ENV SMARTVID_API_URL_INTERNAL=http://127.0.0.1:3100
ENV SMARTVID_WEB_HOST=0.0.0.0
ENV SMARTVID_WEB_PORT=3000
ENV SMARTVID_BASE_PATH=/smartvid
# Behind a platform URL the host name is not localhost: do not reject it.
ENV SMARTVID_ALLOWED_HOSTS=*

# Debian (glibc) on purpose: the server-side speech recognition library only ships glibc builds, and yt-dlp's
# standalone build runs here, so it can also update itself. Fonts let ffmpeg's subtitles filter draw burned-in subtitles.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-dejavu-core wget ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && wget -q -O /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
 && chmod 755 /usr/local/bin/yt-dlp \
 && /usr/local/bin/yt-dlp --version

WORKDIR /app
COPY --from=api-builder /prod/api/node_modules ./api/node_modules
COPY --from=api-builder /app/apps/api/dist ./api/dist
COPY apps/desktop/resources/drizzle ./api/resources/drizzle
COPY skills ./api/skills
COPY --from=web-builder /app/apps/web/dist ./web/dist
COPY --from=web-builder /app/apps/web/server.mjs ./web/server.mjs
COPY --from=web-builder /prod/web/node_modules ./web/node_modules
COPY beam/start.sh /app/start.sh

# Runs as root on purpose: a platform-mounted disk is usually root-owned, and a non-root user could not write to it.
RUN mkdir -p /data/downloads /data/smartvid
EXPOSE 3000
CMD ["/app/start.sh"]
