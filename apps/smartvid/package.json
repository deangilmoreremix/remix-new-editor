{
  "name": "smartvid-vendored",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "install:smartvid": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile",
    "setup": "pnpm --filter ./apps/desktop run setup",
    "build": "SMARTVID_BASE_PATH=${SMARTVID_BASE_PATH:-/smartvid} pnpm --filter ./apps/desktop run build",
    "build:api": "pnpm --filter api run build",
    "build:web": "pnpm --filter web run build",
    "build:cli": "pnpm --filter ./apps/cli run build",
    "build:extension": "pnpm --filter ./apps/extension build",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "start": "cd apps/desktop && SMARTVID_STATIC_DIR=out-web/renderer SMARTVID_BASE_PATH=${SMARTVID_BASE_PATH:-/smartvid} node out-web/server.mjs"
  }
}
